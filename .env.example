# Copiar a .env y ajustar. Ningún valor de aquí es secreto.
# El fichero .env real está en .gitignore y no debe subirse nunca.

# ---- Aplicación ----
APP_NAME=Dashboard de Proyectos

# ---- Autenticación HTTP Basic ----
# Actívala siempre que la app salga de localhost.
# Con ENABLE_AUTH=true la app se NIEGA A ARRANCAR si AUTH_PASSWORD sigue
# siendo el valor de fábrica ("changeme") o tiene menos de 8 caracteres.
ENABLE_AUTH=false
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# ---- Almacenamiento ----
# Rutas dentro del contenedor; docker-compose.yml las monta desde el host.
DB_PATH=/data/projects.db
BACKUP_KEEP=14

# ---- Repositorios locales ----
LOCAL_REPOS_BASE_PATH=/repos
PROJECTS_SCAN_DEPTH=1

# ---- Tokens de las APIs remotas (opcionales) ----
# Sin token se usan los límites públicos de cada API (bajos).
GITHUB_TOKEN=
GITLAB_TOKEN=
BITBUCKET_TOKEN=

# ---- Frecuencia de sincronización ----
# El ciclo local (git) es barato y frecuente; el remoto va espaciado por los
# límites de la API de GitHub.
LOCAL_SYNC_MINUTES=15
REMOTE_SYNC_MINUTES=60

# ---- Umbrales de estado ----
STALE_PROJECT_DAYS=30
STALE_PR_DAYS=7

# ---- Zona horaria (resumen diario y backups) ----
TIMEZONE=UTC

# ---- Avisos por Telegram (opcionales) ----
# Bot creado con @BotFather; el chat id te lo da @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
